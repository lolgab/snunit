# Upstream versions the stack binaries are built from. Each program needs its change: a patch in patches/
# (Prometheus, Jaeger) or a script (patch-victorialogs.sh, patch-perses.sh). Changing a version means a new stack release:
# bump .github/stack-release and StackRelease in snunit-build-core/SNUnitBuild.scala.
PROMETHEUS_VERSION=v3.15.0
JAEGER_VERSION=v2.22.0
VICTORIALOGS_VERSION=v1.53.0
PERSES_VERSION=v0.54.0
# pnpm builds the web UI of Prometheus (its lockfile is version 9).
PNPM_VERSION=10.34.7
